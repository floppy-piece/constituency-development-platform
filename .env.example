APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=root
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMMA_API_KEY=your_google_ai_studio_or_vertex_api_key
GEMMA_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemma-4-12b:generateContent
GEMMA_MODEL=gemma-4-12b

TELEGRAM_BOT_TOKEN="1234567899:ABTvdinYYI..."
TELEGRAM_WEBHOOK_SECRET="your_secret_key"

# Meta WhatsApp Cloud API Credentials
WHATSAPP_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_secret_verify_token #not obtain from the api but yours
WHATSAPP_ACCESS_TOKEN="EAAG..." # Permanent System User Token or Temporary Token
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_DISPLAY_NUMBER="254712345678" # Phone number without leading '+'
WHATSAPP_APP_SECRET=your_meta_app_secret_key #found in meta developers account settings

GEMINI_API_KEY="your_google_ai_studio_api_key_here" #for whatsapp

#for determining the user current location to assign him/her a constituency obtained from https://www.bigdatacloud.com/account/credentials
GOOGLE_MAPS_API_KEY="api_key"


# ==========================================
# GIS & MAPPING API KEYS for determining the hotspots of requests in a constitution in a map
# ==========================================

# 1. Mapbox (Recommended for custom dark map tiles & high-performance geocoding)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91...your_mapbox_token_here...

# 2. OpenStreetMap / LocationIQ (Great free/affordable alternative for geocoding)
LOCATIONIQ_API_KEY=pk.your_locationiq_key_here

# 3. Geoapify (Alternative for GIS location search & polygon boundary rendering)
GEOAPIFY_API_KEY=your_geoapify_key_here

# 4. Default Coordinates for Constituency Center (e.g., Nairobi / local constituency)
DEFAULT_MAP_LAT=-1.286389
DEFAULT_MAP_LNG=36.817223
DEFAULT_MAP_ZOOM=12